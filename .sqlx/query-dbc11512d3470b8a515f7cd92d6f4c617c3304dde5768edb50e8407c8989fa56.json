  "query": "\n        INSERT INTO sessions (\n            id,\n            user_id,\n            token_hash,\n            expires_at\n        )\n        VALUES (\n            $1,\n            $2,\n            $3,\n            NOW() + INTERVAL '30 days'\n        )\n        RETURNING\n            id,\n            user_id,\n            token_hash,\n            expires_at,\n            created_at\n        ",
